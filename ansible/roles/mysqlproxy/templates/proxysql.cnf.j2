admin_variables =
{
    admin_credentials = "admin:{{ mysql_maxscale_monitor_password }}"
    mysql_ifaces      = "127.0.0.1:6032"
}

mysql_variables =
{
    threads                           = 4
    max_connections                   = 2048
    default_query_delay               = 0
    default_query_timeout             = 36000000
    have_compress                     = true
    poll_timeout                      = 2000

    interfaces                        = "0.0.0.0:{{ proxysql_mysql_port | default('3308') }}"

    mysql_query_retries_on_mismatch   = 1

    monitor_username                  = "maxscale_monitor"
    monitor_password                  = "{{ mysql_maxscale_monitor_password }}"

    monitor_galera_healthcheck_interval = 2000
    monitor_galera_healthcheck_timeout  = 1000

    mysql-multiplexing                = "false"
}

mysql_servers =
(
{% set db_hosts = proxysql_backend_nodes | default(groups['database_servers'] | sort) %}
{% for host in db_hosts %}
    {% set db_ip = hostvars[host]['private_ip'] if (host in hostvars and 'private_ip' in hostvars[host]) else host %}
    # Node {{ loop.index }} ({{ host }} -> {{ db_ip }})
    { address="{{ db_ip }}", port=3306, hostgroup=10, max_connections=200, use_ssl=1 }{{ "," if not loop.last else "" }}
{% endfor %}
)

mysql_galera_hostgroups =
(
    {
        writer_hostgroup        = 10
        backup_writer_hostgroup = 10
        reader_hostgroup        = 10
        offline_hostgroup       = 9000
        active                  = 1
        allow_primary_reads     = 1
        writer_is_also_reader   = 1
        max_writers             = 1
    }
)

{% set hub_env = tw_environments[inventory_hostname] if (tw_environments is defined and inventory_hostname in tw_environments) else None %}
{% set hub_db = mysql_databases[hub_env] if hub_env is not none else None %}
mysql_users =
(
    {
        username          = "maxscale"
        password          = "{{ mysql_maxscale_password }}"
        default_hostgroup = 10
        active            = 1
    },
    {
        username          = "{{ hub_db.username if hub_db is not none else (teamwire_db_user | default('teamwire')) }}"
        password          = "{{ hub_db.password if hub_db is not none else teamwire_db_password }}"
        default_hostgroup = 10
        active            = 1
    },
    {
        username          = "{{ hub_db.backup_username if hub_db is not none else (teamwire_db_backup_user | default('backup')) }}"
        password          = "{{ hub_db.backup_password if hub_db is not none else mysql_backup_user_password }}"
        default_hostgroup = 10
        active            = 1
    }
)

mysql_query_rules =
(
)